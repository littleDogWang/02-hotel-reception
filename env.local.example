# Agora credentials
# Required: found in Agora Console → your project → "App ID"
NEXT_PUBLIC_AGORA_APP_ID=

# Required: found in Agora Console → your project → "App Certificate"
# Server-side only. Never expose this in client code.
NEXT_AGORA_APP_CERTIFICATE=

# Optional: address of this app for the cloud Agent's room-status HTTP tool.
# Local curl/browser checks work without it. Cloud calls need a reachable HTTPS
# deployment or tunnel URL; localhost only works for clients on this computer.
TOP_TEN_SCENARIO_TOOL_BASE_URL=
